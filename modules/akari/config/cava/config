# ============================================================================
# Akari Hoshizaki (ONGEKI Rhythm Spectrum) Cava Config (~/.config/cava/config)
# ============================================================================

[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = pipewire
source = auto

[output]
method = noncurses

[color]
gradient = 1
gradient_count = 6
gradient_color_1 = '#38d9a9'
gradient_color_2 = '#5bc0eb'
gradient_color_3 = '#ff5c8a'
gradient_color_4 = '#ff85a6'
gradient_color_5 = '#ffd166'
gradient_color_6 = '#fff1b8'

[smoothing]
noise_reduction = 75
